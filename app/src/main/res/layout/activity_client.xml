<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top IP & Connection panel -->
    <LinearLayout
        android:id="@+id/connectionPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="#1E1E1E"
        android:elevation="4dp">

        <EditText
            android:id="@+id/edtIpAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="6자리 연결 ID 입력"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:backgroundTint="#03DAC6"
            android:inputType="number"
            android:maxLength="6"
            android:textSize="16sp"
            android:padding="8dp"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="연결"
            android:backgroundTint="#03DAC6"
            android:textColor="#121212"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <TextView
            android:id="@+id/btnFileTransfer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="파일 전송"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Custom Display View for Host Screen -->
    <com.sbs.telecom.remote.RemoteDisplayView
        android:id="@+id/remoteDisplayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/connectionPanel"
        android:background="#000000" />

    <!-- Bottom Navigation Bar (Back / Home / Recent) -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#B31A1A1A"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnNavBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_nav_back"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="뒤로가기"
            android:scaleType="centerInside"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_nav_home"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="홈"
            android:scaleType="centerInside"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnNavRecent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/ic_nav_recent"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="최근 앱"
            android:scaleType="centerInside"
            android:tint="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>
