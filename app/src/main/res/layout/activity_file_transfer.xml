<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- Top Status Header (Refresh button removed) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="파일 전송 대기 중..."
            android:textColor="#7C3AED"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Content Area containing two panes (Upper and Lower) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Upper Pane: 도움 받기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#F3F4F6"
            android:padding="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/txtLeftTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="도움 받기"
                android:textColor="#4F46E5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/txtLeftPath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="경로: Downloads"
                android:textColor="#6B7280"
                android:textSize="11sp"
                android:layout_marginBottom="4dp"/>

            <ListView
                android:id="@+id/listHelpReceive"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#E5E7EB"
                android:dividerHeight="1dp"
                android:choiceMode="singleChoice"
                android:background="#FFFFFF"/>

            <Button
                android:id="@+id/btnSendToHelpGive"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="아래로 전송 (도움 주기로) ⬇"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#4F46E5"
                android:textColor="#FFFFFF"
                android:layout_marginTop="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>

        <!-- Lower Pane: 도움 주기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#F3F4F6"
            android:padding="10dp">

            <TextView
                android:id="@+id/txtRightTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="도움 주기"
                android:textColor="#059669"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/txtRightPath"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="경로: Downloads"
                android:textColor="#6B7280"
                android:textSize="11sp"
                android:layout_marginBottom="4dp"/>

            <ListView
                android:id="@+id/listHelpGive"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#E5E7EB"
                android:dividerHeight="1dp"
                android:choiceMode="singleChoice"
                android:background="#FFFFFF"/>

            <Button
                android:id="@+id/btnSendToHelpReceive"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="위로 전송 (도움 받기로) ⬆"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#4F46E5"
                android:textColor="#FFFFFF"
                android:layout_marginTop="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:indeterminate="true"/>

    <Button
        android:id="@+id/btnCancelTransfer"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="전송 중단"
        android:textSize="11sp"
        android:textStyle="bold"
        android:backgroundTint="#EF4444"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        android:insetTop="0dp"
        android:insetBottom="0dp"/>

</LinearLayout>
