<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="10mm"
    android:paddingBottom="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TeleControl"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="안드로이드 간 초고속 원격 화면 도움"
        android:textColor="#888888"
        android:textSize="14sp"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btnHostMode"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="도움 받기"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6200EE"
        android:layout_marginBottom="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"/>

    <Button
        android:id="@+id/btnClientMode"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="도움 주기"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#121212"
        android:backgroundTint="#03DAC6"
        android:insetTop="0dp"
        android:insetBottom="0dp"/>

    <!-- IP Input & Connection Panel -->
    <LinearLayout
        android:id="@+id/layoutIpInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/edtIpAddress"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:hint="6자리 연결 ID 입력"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:inputType="number"
            android:maxLength="6"
            android:textSize="16sp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#1E1E1E"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:text="연결"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#03DAC6"
            android:textColor="#121212"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Spacer to push copyright to the bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Copyright Notice -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Copyright © 2026 Shinbosung All rights reserved."
        android:textColor="#888888"
        android:textSize="12sp"
        android:textStyle="italic"
        android:layout_marginBottom="8dp"/>

</LinearLayout>
