<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="도움 받기"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- IP Address Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="원격 연결 ID"
                android:textColor="#888888"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txtIpAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="------"
                android:textColor="#03DAC6"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Accessibility Service Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="원격 입력 제어"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtAccessibilityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="상태: 비활성화됨"
                android:textColor="#CF6679"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnAccessibilitySetting"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="권한 설정"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#3700B3"
                android:textColor="#FFFFFF"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
        </LinearLayout>

        <!-- Control Server Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="원격 도움 받기"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="상태: 서버 정지됨"
                android:textColor="#CF6679"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"/>

            <CheckBox
                android:id="@+id/chkAutoStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="자동 도움 요청"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:buttonTint="#03DAC6"/>

            <Button
                android:id="@+id/btnToggleServer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="도움 요청"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#6200EE"
                android:textColor="#FFFFFF"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>

            <Button
                android:id="@+id/btnFileTransfer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="파일 전송"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Spacer to push copyright to the bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Copyright Notice -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copyright © 2026 Shinbosung All rights reserved."
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="italic"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>
</ScrollView>
